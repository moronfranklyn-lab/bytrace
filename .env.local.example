# =============================================================================
#  笔迹 ByTrace · 本地环境变量
#
#  用法：复制本文件为 .env.local，按下面「★ 你要填的」填，其余留空即可。
#        .env.local 已被 .gitignore 排除，不会进 git，也不会进前端产物。
#
#  ★ 三层兜底：新名 BYTRACE_* → 旧名 AUTOARTICLE_* → 更旧名 OPENAI_*
#    所以你只填新名就行；不填任何东西也能跑（走本机 CLI 订阅）。
#
#  自检：填完打开 http://127.0.0.1:3100/api/health 看哪项没配好。
# =============================================================================


# =============================================================================
#  ① 主 Agent —— 大纲 / 正文 / 润色 / 指纹拆解 / critic / 配图打标
#     你选的是 MIMO，填下面 4 行即可。
# =============================================================================

# 供应商：claude-cli | codex-cli | openai-compatible | openai-responses
#   也接受简写：mimo / doubao / ark（都会归到 openai-compatible）
#   留空 = claude-cli（本机 Claude Code 订阅）
BYTRACE_AGENT_PROVIDER=openai-compatible

# MiMo 的 OpenAI 兼容端点
BYTRACE_AGENT_BASE_URL=https://api.xiaomimimo.com/v1

# ★ 你的 MiMo API Key（按量计费，sk- 开头）
#   申请：https://platform.xiaomimimo.com → 控制台创建 API Key
BYTRACE_AGENT_API_KEY=

# 分析类模型（指纹拆解 / 大纲 / critic）
#   可选：mimo-v2.6-pro / mimo-v2.6-flash / mimo-v2.6-pro-ultraspeed / mimo-v2.5-pro / mimo-v2.5
BYTRACE_AGENT_MODEL=mimo-v2.6-pro

# 正文类模型（正文 draft / refine，单独指定便于控风格与成本；不填回退上面那个）
BYTRACE_AGENT_ARTICLE_MODEL=mimo-v2.6-pro

# 可选：MiMo 自带的「联网搜索插件」开关（auto / 1 / 0）
#   注意：这是 MiMo 自己的联网能力，与下面 ② 的豆包搜索是两件独立的事。
#   需到 https://platform.xiaomimimo.com/#/console/plugin 开启，约 5 分钟生效。
# BYTRACE_MIMO_WEB_SEARCH=auto
# BYTRACE_MIMO_FORCE_SEARCH=true


# =============================================================================
#  ② 联网事实搜索 —— compose 的「事实底座」+ 博主名搜索
#
#  ★ 推荐：直接用 MiMo 自带的联网插件，不需要第二个 key！
#    MiMo 的 web_search 挂在对话模型上，复用 ① 的 key 与端点。
#    唯一前提：到 https://platform.xiaomimimo.com/#/console/plugin
#             开启「联网搜索」插件（约 5 分钟生效）
# =============================================================================

# 搜索通道：auto | mimo | doubao | tavily | web-facts
#   auto（默认）= MiMo → 豆包 → Tavily → Google CSE / DuckDuckGo，谁能用谁上
#   用 MiMo 的话填 mimo 最直接（跳过其余通道的判断）
BYTRACE_SEARCH_PROVIDER=mimo

# 火山方舟端点（一般不用改）
# --- 以下仅在你想改用豆包（火山方舟）当搜索源时才需要 ---
# 申请：https://console.volcengine.com/ark → API Key 管理
# 还必须开通「联网内容插件」：控制台 → 服务组件库 → 联网内容插件 → 开通
# （免费开通，按搜索次数计费：国内 ¥16 / 千次）
# BYTRACE_SEARCH_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# BYTRACE_SEARCH_API_KEY=
# BYTRACE_SEARCH_MODEL=doubao-seed-2-1-pro-260628

# 单轮最大关键词数（1-50，默认 5）。越大搜得越广，费用也越高。
# BYTRACE_SEARCH_MAX_KEYWORD=5

# 最多保留多少条来源（默认 5）
# BYTRACE_SEARCH_MAX_RESULTS=5

# 可选：额外垂类来源，逗号分隔。可选 douyin（抖音百科）/ toutiao（头条图文）/ moji（墨迹天气）
# BYTRACE_SEARCH_SOURCES=


# =============================================================================
#  ③ 本机 CLI 兜底（只有在 ① 留空、走 claude-cli / codex-cli 时才需要）
#     留空即走 PATH 与 $HOME 常见位置自动探测，通常一个字都不用填。
# =============================================================================

# 本机 Claude CLI 完整路径（留空自动探测 ~/.local/bin、~/.npm-global/bin、/opt/homebrew/bin…）
# BYTRACE_CLAUDE_BIN=

# 本机 Codex CLI 完整路径（留空走 PATH）
# BYTRACE_CODEX_BIN=

# Codex 的工作目录。给中性目录很重要，否则 codex 会读项目根 AGENTS.md 跑偏。
# BYTRACE_CODEX_CWD=/tmp


# =============================================================================
#  ④ 抓取与配图（可选，不填也能用）
# =============================================================================

# YouTube 字幕 / 频道列表。不填时 YouTube 适配器优雅返回 unsupported。
# 申请：https://console.cloud.google.com → 启用 YouTube Data API v3
# BYTRACE_YOUTUBE_API_KEY=

# Unsplash 免费图库。不填时「免费图库」来源自动禁用，本地素材库仍可用。
# 申请：https://unsplash.com/developers
# BYTRACE_UNSPLASH_ACCESS_KEY=

# 素材扫描的默认目录（不填默认 ~/Pictures）
# BYTRACE_SCAN_DEFAULT_DIR=

# 可选：博主名搜索更精准（不填走免 key 的 DuckDuckGo）
# 申请：https://programmablesearchengine.google.com 建 CSE，再到 cloud console 拿 key
# BYTRACE_GOOGLE_CSE_KEY=
# BYTRACE_GOOGLE_CSE_ID=


# =============================================================================
#  ⑤ 客户端化（方案三用，现在填了也不影响）
# =============================================================================

# 服务端口（默认 3100）
# BYTRACE_PORT=3100

# 数据目录（默认 <项目目录>/data）
# 方案三会把它默认指向 ~/Library/Application Support/ByTrace
# BYTRACE_DATA_DIR=
