# AutoArticle local env. Copy to `.env.local` and fill in.
# .env.local is gitignored.

# LLM provider:
# - claude-cli: keep using local Claude CLI subscription.
# - codex-cli: use local Codex CLI login; not token-streaming, but works without API keys.
# - openai-compatible: use a local OpenAI-compatible API, such as LM Studio or Ollama.
# - openai-responses: use OpenAI Responses API.
AUTOARTICLE_LLM_PROVIDER=claude-cli

# For openai-compatible, defaults to LM Studio's common endpoint if omitted.
# Examples:
# AUTOARTICLE_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AUTOARTICLE_LLM_BASE_URL=http://127.0.0.1:11434/v1
AUTOARTICLE_LLM_BASE_URL=

# Required for openai-responses. Often optional for local openai-compatible servers.
AUTOARTICLE_LLM_API_KEY=

# Required when AUTOARTICLE_LLM_PROVIDER is openai-compatible or openai-responses.
# Use the exact model id exposed by your API server.
AUTOARTICLE_LLM_MODEL=

# Optional: use a separate model for draft/refine article writing.
# If omitted, AUTOARTICLE_LLM_MODEL is used.
AUTOARTICLE_LLM_ARTICLE_MODEL=

# Optional: only for codex-cli provider.
# Defaults to `codex` and `/tmp`.
AUTOARTICLE_CODEX_BIN=
AUTOARTICLE_CODEX_CWD=

# 申请 https://unsplash.com/developers/ 后填入 Access Key。
# 不填的话「免费图库」来源自动禁用，本地素材库仍可用。
UNSPLASH_ACCESS_KEY=

# Agent I · YouTube 视频字幕 / 频道列表抓取需要的 API key。
# 申请：https://console.cloud.google.com → 启用 YouTube Data API v3 → 创建 API key。
# 不填的话 YouTube 适配器优雅返回 unsupported，不影响其他平台。
YOUTUBE_DATA_API_KEY=

# Agent I · 博主名搜索可选走 Google Custom Search API（精度更高）。
# 不填两者就走 DuckDuckGo HTML 搜索（免 key）。
# 申请：https://programmablesearchengine.google.com 建一个 CSE，再在 cloud console 拿 API key。
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Optional: realtime search for /compose background research material.
# 不填的话会跳过实时搜索，不阻塞写作主流程。
TAVILY_API_KEY=

# ---- 事实底座联网搜索 ----
# MiMo web_search：AUTOARTICLE_LLM_* 已指向 api.xiaomimimo.com 且为 sk- key 时默认尝试。
# 需在 https://platform.xiaomimimo.com/#/console/plugin 开启「联网搜索」插件。
# AUTOARTICLE_MIMO_WEB_SEARCH=auto
# AUTOARTICLE_MIMO_FORCE_SEARCH=true
# AUTOARTICLE_MIMO_SEARCH_LIMIT=5
# AUTOARTICLE_MIMO_MAX_KEYWORD=3
#
# 自带联网搜索（MiMo/Tavily 都不可用时自动回落）：
# - 配了 GOOGLE_CSE_KEY + GOOGLE_CSE_ID → Google CSE
# - 否则 DuckDuckGo HTML（免 key）

# Apify · 走 Apify Actor 爬反爬强的平台（知乎/B站/小红书/抖音/公众号）。
# 申请：https://console.apify.com/settings/integrations
# 免费 $5/月，够个人写作工具用量。
APIFY_TOKEN=
